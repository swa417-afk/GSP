# GSP Reference App Backend Configuration
# Copy this file to .env and fill in your values

PORT=4000
DB_PATH=./gsp.sqlite
# Generate a UNIQUE random value locally; never commit a real key
JWT_SECRET=
GSP_HOST=127.0.0.1
GSP_ALLOWED_ORIGINS=http://localhost:5173
APP_NAME=GSP Reference App
ATTESTATION_MODE=simulated
